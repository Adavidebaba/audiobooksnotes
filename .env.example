# Audiobookshelf URL and API Token
ABS_URL=http://localhost:8080
ABS_TOKEN=your_abs_api_token_here

# OpenRouter Credentials
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_STT_MODEL=mistralai/voxtral-mini-transcribe
OPENROUTER_LLM_MODEL=openrouter/auto

# Application Configuration
POLL_INTERVAL_SECONDS=60
PRE_SECONDS=30
POST_SECONDS=30
LANGUAGE=it
DATA_DIR=/data
LOG_LEVEL=INFO

# Bootstrap Mode: all (process everything), skip (ignore historical), since (only after specific date)
BOOTSTRAP_MODE=skip
BOOTSTRAP_SINCE_ISO=2026-05-21T00:00:00Z

# YouTube via Google Sheets (optional - leave empty to disable)
# Create a Google Cloud API Key with Sheets API enabled
# Share the Google Sheet as "Anyone with the link can view"
GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here
YOUTUBE_SHEET_ID=your_google_sheet_id_here
YOUTUBE_PRE_SECONDS=60
YOUTUBE_POST_SECONDS=60

# Audiobookshelf URL and API Token
ABS_URL=http://localhost:8080
ABS_TOKEN=your_abs_api_token_here

# OpenAI Credentials
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_STT_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o

# Application Configuration
POLL_INTERVAL_SECONDS=60
PRE_SECONDS=30
POST_SECONDS=30
LANGUAGE=it
DATA_DIR=/data
LOG_LEVEL=INFO

# Bootstrap Mode: all (process everything), skip (ignore historical), since (only after specific date)
BOOTSTRAP_MODE=skip
BOOTSTRAP_SINCE_ISO=2026-05-21T00:00:00Z

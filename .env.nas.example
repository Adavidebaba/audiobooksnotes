# ==============================================================================
# CONFIGURAZIONE AMBIENTE PER SYNOLOGY NAS - CITAZIONI (AUDIOBOOKNOTES)
# Copia questo file come '.env' all'interno di:
# /volumeUSB1/usbshare/docker/audiobooknotes/.env
# ==============================================================================

# Audiobookshelf URL e Token API (verificato su Traefik / LAN del NAS)
ABS_URL=https://audiobooks.adavide.com
ABS_TOKEN=inserisci_qui_il_tuo_token_api_abs

# Credenziali OpenRouter (per trascrizione Whisper ed estrazione citazioni LLM)
OPENROUTER_API_KEY=inserisci_qui_la_tua_openrouter_api_key
OPENROUTER_STT_MODEL=mistralai/voxtral-mini-transcribe
OPENROUTER_LLM_MODEL=openrouter/auto

# Parametri applicativi
POLL_INTERVAL_SECONDS=600
PRE_SECONDS=20
POST_SECONDS=20
LANGUAGE=it
DATA_DIR=/data
LOG_LEVEL=INFO

# Modalità Bootstrap per Audiobookshelf:
# 'all' = processa tutti i bookmark esistenti
# 'skip' = ignora i bookmark passati e processa solo i futuri
# 'since' = processa solo dal timestamp specificato in BOOTSTRAP_SINCE_ISO
BOOTSTRAP_MODE=skip
BOOTSTRAP_SINCE_ISO=2026-05-21T00:00:00Z

# Integrazione YouTube via Google Sheets (opzionale - lascia vuoto per disabilitare)
GOOGLE_SHEETS_API_KEY=
YOUTUBE_SHEET_ID=
YOUTUBE_PRE_SECONDS=60
YOUTUBE_POST_SECONDS=60
